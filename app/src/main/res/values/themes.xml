    <style name="Theme.Practicados" parent="Base.Theme.Practicados" />
    <!-- Estilo para mis botones -->
    <style name="BotonGVA">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/primarioAAME</item>
        <item name="android:textColor">@color/textoBotonAAME</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <!-- Estilo para mis cuadros de texto -->

    <style name="CampoGVA" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/textoAAME</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">10dp</item>
    </style>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondoGVA"
    tools:context=".MainActivity">

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="261dp"
        android:layout_height="222dp"
        app:layout_constraintBottom_toTopOf="@+id/tvMensaje"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.41"
        app:srcCompat="@drawable/imagen_logo" />

    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/msg_inicialGVA"
        android:textColor="@color/textoGVA"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/etxNombre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etxNombre"
        style="@style/CampoGVA"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nombreGVA"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/etxMatricula"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etxMatricula"
        style="@style/CampoGVA"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_matriculaGVA"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/btnRegistrar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnRegistrar"
        style="@style/BotonGVA"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_registrarGVA"
        app:layout_constraintBottom_toTopOf="@+id/btnLimpiar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnLimpiar"
        style="@style/BotonGVA"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_limpiarGVA"
        app:layout_constraintBottom_toTopOf="@+id/btnTema"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTema"
        style="@style/BotonGVA"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_tema_oscuroGVA"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/pbCarga"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>